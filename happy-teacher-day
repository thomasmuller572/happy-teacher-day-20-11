<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tri Ân Thầy Cô 20/11 📚</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            height: 100vh;
            background: linear-gradient(135deg, #2b5876 0%, #4e4376 100%);
            overflow: hidden;
            font-family: 'Montserrat', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        /* Canvas hiệu ứng đồ họa nền */
        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        /* Khung Thiệp Trung Tâm */
        .card {
            background: rgba(255, 255, 255, 0.92);
            padding: 40px 30px;
            border-radius: 24px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
            text-align: center;
            z-index: 10;
            max-width: 480px;
            width: 90%;
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 215, 0, 0.5);
            animation: popUp 1s ease-out;
        }

        @keyframes popUp {
            0% { transform: scale(0.5); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .icon {
            font-size: 3.5rem;
            margin-bottom: 10px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }

        h1 {
            font-family: 'Dancing Script', cursive;
            color: #d4af37; /* Màu vàng sang trọng */
            font-size: 3rem;
            margin-bottom: 15px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }

        /* Hiệu ứng gõ chữ */
        .typing-text {
            color: #333;
            font-size: 1.05rem;
            line-height: 1.6;
            min-height: 100px;
            margin-bottom: 25px;
            font-weight: 600;
            border-right: 2px solid #d4af37;
            white-space: pre-wrap;
            animation: blink 0.75s step-end infinite;
        }

        @keyframes blink {
            from, to { border-color: transparent }
            50% { border-color: #d4af37; }
        }

        .btn {
            background: linear-gradient(45deg, #f39c12, #d4af37);
            color: white;
            border: none;
            padding: 12px 28px;
            font-size: 1rem;
            border-radius: 30px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.4);
        }

        .btn:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.6);
        }
    </style>
</head>
<body>

    <!-- Canvas hiệu ứng hạt sao/hoa hướng dương bay -->
    <canvas id="effectCanvas"></canvas>

    <!-- Khung thiệp -->
    <div class="card">
        <div class="icon">🎓</div>
        <h1>Tri Ân 20/11 🌟</h1>
        <div class="typing-text" id="typing"></div>
        <button class="btn" onclick="triggerFireworks()">Bắn Pháo Hoa Tri Ân 🎆</button>
    </div>

    <script>
        const canvas = document.getElementById('effectCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // 1. Hiệu ứng gõ chữ lời chúc 20/11
        const message = "Nhân ngày Nhà giáo Việt Nam 20/11, xin gửi lời chúc chân thành và sâu sắc nhất đến các thầy cô. Chúc thầy cô luôn dồi dào sức khỏe, hạnh phúc và giữ mãi ngọn lửa đam mê với sự nghiệp trồng người cao quý!";
        let index = 0;
        const speed = 40;

        function typeWriter() {
            if (index < message.length) {
                document.getElementById("typing").innerHTML += message.charAt(index);
                index++;
                setTimeout(typeWriter, speed);
            }
        }
        setTimeout(typeWriter, 800);

        // 2. Hiệu ứng ngôi sao / hạt vàng rơi nền
        let particles = [];

        class Star {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * -canvas.height;
                this.size = Math.random() * 4 + 2;
                this.speedY = Math.random() * 1.5 + 0.5;
                this.speedX = Math.random() * 1 - 0.5;
                this.opacity = Math.random() * 0.7 + 0.3;
            }

            update() {
                this.y += this.speedY;
                this.x += this.speedX;
                if (this.y > canvas.height) {
                    this.y = -10;
                    this.x = Math.random() * canvas.width;
                }
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = this.opacity;
                ctx.fillStyle = '#f1c40f'; // Màu vàng ấm áp
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        for (let i = 0; i < 50; i++) {
            particles.push(new Star());
        }

        // 3. Hiệu ứng pháo hoa khi bấm nút
        let fireworks = [];

        class FireworkParticle {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 6 + 2;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
                this.alpha = 1;
                this.color = `hsl(${Math.random() * 50 + 35}, 100%, 65%)`; // Tông màu vàng / cam rực rỡ
                this.size = Math.random() * 4 + 2;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.vy += 0.05;
                this.alpha -= 0.015;
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = this.alpha;
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        function triggerFireworks() {
            for (let f = 0; f < 3; f++) {
                let fx = Math.random() * (canvas.width - 200) + 100;
                let fy = Math.random() * (canvas.height / 2);
                for (let i = 0; i < 50; i++) {
                    fireworks.push(new FireworkParticle(fx, fy));
                }
            }
        }

        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            particles.forEach(p => {
                p.update();
                p.draw();
            });

            fireworks.forEach((fw, index) => {
                fw.update();
                fw.draw();
                if (fw.alpha <= 0) {
                    fireworks.splice(index, 1);
                }
            });

            requestAnimationFrame(animate);
        }

        animate();
    </script>
</body>
</html>
